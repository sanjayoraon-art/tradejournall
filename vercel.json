{
    "crons": [
        {
            "path": "/api/generate-blog?type=trending",
            "schedule": "30 0 * * *"
        },
        {
            "path": "/api/generate-blog?type=evergreen",
            "schedule": "30 2 * * *"
        }
    ],
    "routes": [
        {
            "src": "/sitemap.xml",
            "dest": "/api/sitemap"
        }
    ],
    "rewrites": [
        {
            "source": "/blog/:slug",
            "destination": "/api/render-blog?slug=$slug"
        },
        {
            "source": "/((?!api/|game-page\\.html|buy-the-dip\\.html).*)",
            "destination": "/index.html"
        }
    ]
}