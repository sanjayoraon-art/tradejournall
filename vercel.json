{
    "headers": [
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml; charset=utf-8"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, stale-while-revalidate=86400"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/rss.xml",
            "destination": "/api/rss"
        },
        {
            "source": "/feed.xml",
            "destination": "/api/rss"
        },
        {
            "source": "/privacy",
            "destination": "/privacy.html"
        },
        {
            "source": "/candle-clash",
            "destination": "/game-page.html"
        },
        {
            "source": "/game",
            "destination": "/game-page.html"
        },
        {
            "source": "/buy-the-dip",
            "destination": "/buy-the-dip.html"
        },
        {
            "source": "/blog/:slug",
            "destination": "/api/render-blog?slug=:slug"
        },
        {
            "source": "/tools/:path*",
            "destination": "/api/render-tool?path=:path*"
        },
        {
            "source": "/calculators/:path*",
            "destination": "/api/render-tool?path=:path*"
        },
        {
            "source": "/((?!api/|game-page\\.html|buy-the-dip\\.html|privacy\\.html|game|buy-the-dip|candle-clash|tools|calculators).*)",
            "destination": "/index.html"
        }
    ]
}